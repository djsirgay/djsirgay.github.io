:root{--paper:#f3efe8;--ink:#12110f;--red:#e74d8e;--blue:#2525d8;--line:rgba(18,17,15,.19);--muted:#6f6963}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}button,select{font:inherit}.head{height:76px;position:sticky;top:0;z-index:20;background:rgba(243,239,232,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 3vw}.brand{font-weight:900;letter-spacing:-.04em}.brand b{color:var(--red)}.nav{display:flex;gap:24px;font-size:11px;text-transform:uppercase;letter-spacing:.12em}.tools{display:flex;align-items:center;gap:14px}.lang button{border:0;background:none;cursor:pointer;opacity:.4;font-size:10px}.lang button.on{opacity:1;font-weight:900}.cart{border:1px solid var(--ink);background:none;padding:10px 13px;text-transform:uppercase;letter-spacing:.1em;font-size:10px;cursor:pointer}.hero{display:grid;grid-template-columns:minmax(380px,.95fr) minmax(500px,1.05fr);min-height:calc(100vh - 76px);border-bottom:1px solid var(--line)}.art{background:#e5c9da;display:grid;place-items:center;position:sticky;top:76px;height:calc(100vh - 76px);overflow:hidden;border-right:1px solid var(--line)}.art img{width:min(74%,660px);aspect-ratio:1;object-fit:cover;position:relative;z-index:2;transform:translateX(-5%);box-shadow:0 35px 75px rgba(64,20,42,.28)}.vinyl{position:absolute;width:min(69%,620px);aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(circle,#161412 0 4px,#2b2825 5px 7px,#111 8px 10px);transform:translateX(33%);box-shadow:0 26px 55px rgba(0,0,0,.35)}.vinyl:after{content:"NRZ-009";position:absolute;inset:36%;border-radius:50%;background:var(--red);display:grid;place-items:center;color:white;font-size:11px;font-weight:900;letter-spacing:.13em}.copy{padding:62px 6vw 80px 5vw}.call{border-top:1px solid var(--red);border-bottom:1px solid var