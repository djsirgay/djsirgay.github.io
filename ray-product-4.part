ция",[11.99,11.99,12.99],["https://buy.stripe.com/9B6aEX6T8eBvam70I4aAw0Q","https://buy.stripe.com/8x2cN56T83WR9i376saAw0R","https://buy.stripe.com/5kQ00jgtIctn65RfCYaAw0S"]],"NL":["Netherlands","Нидерланды",[12.99,13.99,14.99],["https://buy.stripe.com/28EfZha5k0KF8dZ76saAw0T","https://buy.stripe.com/bJeeVdgtI9hb51NeyUaAw0U","https://buy.stripe.com/6oU9ATb9odxreCnaiEaAw0V"]],"FI":["Finland","Финляндия",[18.99,19.99,21.99],["https://buy.stripe.com/aFacN5b9o0KFfGr3UgaAw0W","https://buy.stripe.com/6oUcN5fpE50V9i376saAw0X","https://buy.stripe.com/9B63cv6T89hbbqbfCYaAw0Y"]],"EE":["Estonia","Эстония",[14.99,16.99,17.99],["https://buy.stripe.com/dRmdR991gctngKv3UgaAw0Z","https://buy.stripe.com/cNifZh91ggJD8dZ62oaAw10","https://buy.stripe.com/00wcN54L07939i31M8aAw11"]]}; const P=59.99; let lang=localStorage.getItem('nrz-lang')||'en'; let country='US',qty=1,cart=false;
try{const x=JSON.parse(localStorage.getItem('nrz-ray-cart'));if(x&&S[x.country]){country=x.country;qty=x.qty||1;cart=true}}catch{}
const $=s=>document.querySelector(s), money=n=>'$'+n.toFixed(2);
function text(){document.documentElement.lang=lang;document.querySelectorAll('[data-en]').forEach(e=>e.textContent=e.dataset[lang]);$('.enText').hidden=lang!=='en';$('.ruText').hidden=lang!=='ru';$('#en').classList.toggle('on',lang==='en');$('#ru').classList.toggle('on',lang==='ru');}
function controls(id){const d=S[country];document.querySelector(id).innerHTML=`<div class="controls"><label><span>${lang==='ru'?'Страна доставки':'Shipping country'}</span><select class="country">${Object.entries(S).map(([k,v])=>`<option value="${k}" ${k===country?'selected':''}>${v[lang==='ru'?1:0]}</option>`).join('')}</select></label><fieldset><legend>${lang==='ru'?'Количество пластинок':'Number of records'}</legend><div class="qty">${[1,2,3].map(n=>`<button class="${qty===n?'on':''}" data-q="${n}">${n}</button>`).join('')}</div></fieldset></div>`}
function summary(id){const d=S[country],fee=d[2][qty-1],sub=P*qty,total=sub+fee;document.querySelector(id).innerHTML=`<dl class="summary"><div><dt>${lang==='ru'?'Пластинки':'Records'} × ${qty}</dt><dd>${money(sub)}</dd></div><div><dt>${d[lang==='ru'?1:0]} · ${lang==='ru'?'Доставка и обработка':'Shipping & handling'}</dt><dd>${money(fee)}</dd></div><div class="total"><dt>${lang==='ru'?'Итого до налога':'Total before tax'}</dt><dd>${money(total)}</dd></div></dl>`;$('#checkout1').href=d[3][qty-1];$('#checkout2').href=d[3][qty-1]}
function bind(){document.querySelectorAll('.country').forEach(e=>e.onchange=()=>{country=e.value;render()});document.querySelectorAll('[data-q]').forEach(e=>e.onclick=()=>{qty=+e.dataset.q;render()})}
function render(){text();controls('#controls1');controls('#controls2');summary('#summary1');summary('#summary2');bind();$('#count').textContent=cart?qty:0;if(cart)localStorage.setItem('nrz-ray-cart',JSON.stringify({country,qty}));else localStorage.removeItem('nrz-ray-cart')}
function openCart(){cart=true;render();$('#drawer').classList.add('on');$('#shade').classList.add('on')}function closeCart(){$(' #drawer'.trim()).classList.remove('on');$('#shade').classList.remove('on')}
$('#en').onclick=()=>{lang='en';localStorage.setItem('nrz-lang',lang);render()};$('#ru').onclick=()=>{lang='ru';localStorage.setItem('nrz-lang',lang);render()};document.querySelectorAll('.add').forEach(e=>e.onclick=openCart);$('#cartBtn').onclick=openCart;$('#close').onclick=closeCart;$('#shade').onclick=closeCart;$('#remove').onclick=()=>{cart=false;closeCart();render()};render();
</script></body></html>