5,255,.5);padding:28px}.controls{display:grid;grid-template-columns:1.5fr 1fr;gap:22px}.controls label>span,.controls legend{display:block;margin-bottom:8px;font-size:9px;text-transform:uppercase;letter-spacing:.12em}.controls select{width:100%;height:50px;padding:0 12px;border:1px solid white;background:var(--blue);color:white}.controls fieldset{border:0;margin:0;padding:0}.qty{display:grid;grid-template-columns:repeat(3,1fr)}.qty button{height:50px;border:1px solid white;background:none;color:white;margin-left:-1px;cursor:pointer}.qty button.on{background:white;color:var(--blue)}.summary{margin:28px 0 0}.summary>div{display:flex;justify-content:space-between;gap:16px;border-top:1px solid rgba(255,255,255,.3);padding:12px 0;font-size:12px}.summary dd{margin:0;font:17px Georgia,serif}.summary .total{font-weight:900;padding-top:18px}.summary .total dd{font-size:30px}.actions{display:grid;grid-template-columns:.7fr 1.3fr;gap:10px;margin-top:22px}.actions button{border:1px solid white;background:none;color:white;padding:15px;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:900;cursor:pointer}.actions a,.pay{background:white;color:var(--ink);padding:15px 17px;display:flex;align-items:center;justify-content:space-between;gap:16px;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:900}.actions a:hover,.pay:hover{background:var(--red);color:white}.note{font-size:10px;line-height:1.5;color:rgba(255,255,255,.74);margin:16px 0 0}.extras{padding:100px 6vw;display:grid;grid-template-columns:1fr 1fr;gap:6vw}.extras ul{columns:2;list-style:none;padding:0;margin:0;column-gap:40px}.extras li{break-inside:avoid;border-top:1px solid var(--line);padding:15px 0;font:18px/1.35 Georgia,serif}.foot{padding:45px 4vw;background:#d8d1ca;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;font-size:10px;text-transform:uppercase;letter-spacing:.11em}.shade{position:fixed;inset:0;background:rgba(18,17,15,.57);z-index:50;opacity:0;visibility:hidden;transition:.25s}.shade.on{opacity:1;visibility:visible}.drawer{position:fixed;right:0;top:0;width:min(520px,100%);height:100vh;background:var(--paper);z-index:60;padding:24px 28px 34px;overflow:auto;transform:translateX(100%);transition:.3s;box-shadow:-22px 0 60px rgba(0,0,0,.25)}.drawer.on{transform:none}.dhead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:15px;margin-bottom:23px}.dhead h2{font:400 42px Georgia,serif;margin:0}.dhead button{border:0;background:none;font-size:32px;cursor:pointer}.item{display:grid;grid-template-columns:100px 1fr;gap:16px;margin-bottom:26px}.item img{width:100px;height:100px;object-fit:cover}.item p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;margin:3px 0}.item h3{font:400 36px Georgia,serif;margin:0}.drawer .controls select{background:var(--paper);color:var(--ink);border-color:var(--ink)}.drawer .qty button{color:var(--ink);border-color:var(--ink)}.drawer .qty button.on{background:var(--ink);color:var(--paper)}.drawer .summary>div{border-color:var(--line)}.pay{background:var(--ink);color:var(--paper);margin-top:22px}.remove{width:100%;border:0;background:none;text-decoration:underline;margin-top:14px;cursor:pointer}.drawer .note{color:var(--muted)}@media(max-width:1000px){.nav{display:none}.hero{grid-template-columns:1fr}.art{position:relative;top:auto;height:75vw;min-height:520px;border-right:0;border-bottom:1px solid var(--line)}.checkout,.extras{grid-template-columns:1fr}}@media(max-width:650px){.head{height:66px;padding:0 16px}.brand{font-size:13px}.art{height:112vw;min-height:400px}.art img{width:73%}.vinyl{width:68%;transform:translateX(29%)}.copy{padding:48px 20px 65px}.call{flex-direction:column;gap:5px}.copy h1{font-size:96px}.story{font-size:18px}.facts{grid-template-columns:1fr}.facts dl:nth-child(odd){border-right:0}.facts dl:nth-child(even){padding-left:0}.price{align-items:stretch;flex-direction:column}.checkout{padding:68px 18px}.panel{padding:18px}.controls{grid-template-columns:1fr}.actions{grid-template-columns:1fr}.extras{padding:68px 20px}.extras ul{columns:1}.foot{flex-direction:column}.drawer{padding:20px}}
</style></head><body>
